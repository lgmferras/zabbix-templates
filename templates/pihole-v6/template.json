                    {
                        "uuid": "f76c8bd39abe4080987b673f8702be0e",
                        "name": "Pi-hole: coleta da API",
                        "type": "SCRIPT",
                        "key": "pihole.get",
                        "delay": "2m",
                        "history": "0",
                        "value_type": "TEXT",
                        "params": "// Coleta do Pi-hole v6 pela API REST, com sess\u00e3o aberta e encerrada a cada coleta.\n// Par\u00e2metros: url (ex. http://192.168.0.2:20720) e password (senha de\n// aplicativo do Pi-hole \u2014 Settings > Web interface / API > App password).\nvar p = JSON.parse(value);\nvar base = String(p.url || '').replace(/\\/+$/, '') + '/api';\nif (!p.password) throw 'Macro {$PIHOLE.PASSWORD} vazia';\n\nfunction call(method, path, body, sid) {\n  var r = new HttpRequest();\n  r.addHeader('Content-Type: application/json');\n  if (sid) r.addHeader('X-FTL-SID: ' + sid);\n  var resp = method === 'POST' ? r.post(base + path, JSON.stringify(body))\n    : method === 'DELETE' ? r.delete(base + path) : r.get(base + path);\n  var code = r.getStatus();\n  if (code < 200 || code >= 300) throw 'HTTP ' + code + ' em ' + path + ': ' + String(resp).substring(0, 200);\n  return resp ? JSON.parse(resp) : {};\n}\n\nvar auth = call('POST', '/auth', { password: p.password });\nif (!auth.session || !auth.session.valid) throw 'Login recusado pelo Pi-hole';\nvar sid = auth.session.sid;\nvar out = {};\ntry {\n  var s = call('GET', '/stats/summary', null, sid);\n  out.queries_total = s.queries.total;\n  out.queries_blocked = s.queries.blocked;\n  out.percent_blocked = Math.round(s.queries.percent_blocked * 100) / 100;\n  out.queries_cached = s.queries.cached;\n  out.queries_forwarded = s.queries.forwarded;\n  out.unique_domains = s.queries.unique_domains;\n  out.clients_active = s.clients.active;\n  out.gravity_domains = s.gravity.domains_being_blocked;\n  out.gravity_last_update = s.gravity.last_update;\n\n  out.blocking = call('GET', '/dns/blocking', null, sid).blocking === 'enabled' ? 1 : 0;\n\n  var v = call('GET', '/info/version', null, sid).version;\n  var upd = 0;\n  var parts = [];\n  ['core', 'web', 'ftl'].forEach(function (k) {\n    var loc = v[k] && v[k].local ? v[k].local.version : null;\n    var rem = v[k] && v[k].remote ? v[k].remote.version : null;\n    parts.push(k + ' ' + loc);\n    if (loc && rem && loc !== rem) upd = 1;\n  });\n  out.version = parts.join(', ') + (v.docker && v.docker.local ? ' (imagem ' + v.docker.local + ')' : '');\n  out.update_available = upd;\n\n  var m = call('GET', '/info/messages', null, sid).messages || [];\n  out.messages_count = m.length;\n  out.messages_last = m.length ? String(m[m.length - 1].plain).substring(0, 250) : '';\n\n  var f = call('GET', '/info/ftl', null, sid).ftl;\n  out.ftl_uptime = Math.floor(f.uptime / 1000); // a API devolve milissegundos\n  out.ftl_mem_pct = Math.round(f['%mem'] * 100) / 100;\n  out.ftl_cpu_pct = Math.round(f['%cpu'] * 100) / 100;\n  out.query_frequency = f.query_frequency;\n\n  // Servidores de sa\u00edda reais (exclui \"cache\" e \"blocklist\", que v\u00eam com port -1)\n  var ups = call('GET', '/stats/upstreams', null, sid).upstreams || [];\n  var worst = 0, n = 0;\n  ups.forEach(function (u) {\n    if (u.port > 0) {\n      n++;\n      if (u.count > 0 && u.statistics && u.statistics.response > worst) worst = u.statistics.response;\n    }\n  });\n  out.upstream_count = n;\n  out.upstream_response_max = Math.round(worst * 10000) / 10000;\n} finally {\n  try { call('DELETE', '/auth', null, sid); } catch (e) { }\n}\nreturn JSON.stringify(out);",
                        "description": "Item mestre: faz login na API REST do Pi-hole v6 com a senha de aplicativo ({$PIHOLE.PASSWORD}), l\u00ea estat\u00edsticas, bloqueio, vers\u00f5es, diagn\u00f3stico, FTL e servidores de sa\u00edda, e encerra a sess\u00e3o. history=0: s\u00f3 alimenta os dependentes.",
                        "timeout": "30s",
                        "parameters": [
                            {
                                "name": "password",
                                "value": "{$PIHOLE.PASSWORD}"
                            },
                            {
                                "name": "url",
                                "value": "{$PIHOLE.SCHEME}://{HOST.CONN}:{$PIHOLE.PORT}"
                            }
                        ],
                        "tags": [
                            {
                                "tag": "component",
                                "value": "raw"
                            }
                        ]
                    },
