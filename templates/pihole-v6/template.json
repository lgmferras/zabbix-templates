                                "expression": "last(/Pi-hole v6 by HTTP/pihole.ftl.uptime)<600",
                                "name": "Pi-hole: FTL reiniciado",
                                "opdata": "{ITEM.LASTVALUE1}",
                                "priority": "INFO",
                                "description": "O servi\u00e7o de DNS do Pi-hole (FTL) reiniciou h\u00e1 menos de 10 minutos.",
