        "templates": [
            {
                "uuid": "a5bb42b366a646d8a6c097a7f5e7912a",
                "template": "Template Zabbix NFe Monitor",
                "name": "Template Zabbix NFe Monitor",
                "description": "Monitoramento da disponibilidade dos autorizadores de NF-e (SEFAZ) via scraping\nda página oficial https://www.nfe.fazenda.gov.br/portal/disponibilidade.aspx.\n\nRequer o UserParameter nfe.status.json (zbx_agent2_conf.d/nfe.conf) e a imagem\ncustom do zabbix-agent2 com Python (Dockerfiles/zabbix-agent2).\n\nStatus do semáforo: Verde (1), Amarelo (2), Vermelho (0), Sem imagem (-1 = serviço\nnão oferecido pelo autorizador). O item mestre coleta 1x e todos os autorizadores/\nserviços derivam dele (LLD dependente — um único scrape a cada 5m).\n\nFiltre os autorizadores relevantes na macro {$NFE.UF.MATCHES} — padrão SP + SVC-AN\n(SEFAZ Virtual de Contingência que atende SP).",
                "groups": [
                    {
                        "name": "Templates/Applications"
                    }
                ],
                "items": [
                    {
                        "uuid": "2501413ead414c3b9de3f0e1e70fe631",
                        "name": "NFe: Master Status Data",
                        "key": "nfe.status.json",
                        "delay": "5m",
                        "history": "1d",
                        "value_type": "TEXT",
                        "description": "JSON completo com o status de todos os autorizadores (fonte dos itens dependentes e do LLD).",
                        "triggers": [
                            {
                                "uuid": "4abedc0271ec4f37a7d75372c5f25a21",
                                "expression": "nodata(/Template Zabbix NFe Monitor/nfe.status.json,30m)=1",
                                "name": "NFe: coleta da página da SEFAZ sem dados há 30 minutos",
                                "priority": "WARNING",
                                "description": "O scrape da página de disponibilidade falhou repetidamente (script em erro, página fora do ar ou mudança de layout). Sem esse dado, os status por autorizador ficam congelados.",
                                "manual_close": "YES"
                            }
                        ]
                    }
                ],
                "discovery_rules": [
                    {
                        "uuid": "ec6f0590248340508368f14d54bb6ac5",
                        "name": "Descoberta de Autorizadores (UF)",
                        "type": "DEPENDENT",
                        "key": "nfe.autorizador.discovery",
