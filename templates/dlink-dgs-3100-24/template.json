            {
                "uuid": "ae44ee52a9d34b7896a739ddeb7b59f6",
                "template": "D-Link DGS-3100-24 by SNMP",
                "name": "D-Link DGS-3100-24 by SNMP",
                "description": "Template SNMP para D-Link DGS-3100-24 (firmware 3.60.28).\n\nMIBs utilizadas (confirmadas via snmpwalk):\n  SNMPv2-MIB         — sysName, sysContact, sysLocation, sysDescr, sysUpTime\n  HOST-RESOURCES-MIB — hrSystemUptime (uptime de hardware)\n  IF-MIB (HC)        — interfaces, tráfego 64-bit, erros\n  ENTITY-MIB         — firmware, hardware, boot version, serial, fan, PSU\n\nMIBs NÃO disponíveis neste firmware:\n  DLINK-AGENT-MIB    (1.3.6.1.4.1.171.12.1.1) — CPU e memória indisponíveis\n  EQUIPMENT-MIB      (1.3.6.1.4.1.171.12.11)  — fan via OID D-Link indisponível\n\nFan e PSU monitorados via ENTITY-MIB entPhysicalOperStatus:\n  Fan1 index:  67109249  — OID 1.3.6.1.2.1.47.1.1.1.1.16.67109249\n  PSU  index:  67109185  — OID 1.3.6.1.2.1.47.1.1.1.1.16.67109185",
                "groups": [
                    {
                        "name": "Templates/Network devices"
                    }
                ],
                "items": [
                    {
                        "uuid": "2ce6438164074154a8d71fce34ae1559",
                        "name": "ICMP ping",
                        "type": "SIMPLE",
                        "key": "icmpping",
                        "delay": "3m",
                        "history": "90d",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "network"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "02d86a9d18644aaebab29bb6104e0748",
                                "expression": "max(/D-Link DGS-3100-24 by SNMP/icmpping,#3)=0",
                                "name": "Switch sem resposta ICMP",
                                "priority": "HIGH",
                                "description": "Três tentativas consecutivas sem resposta.",
                                "manual_close": "YES",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "c597b8640e464fe69653764390110984",
                        "name": "ICMP loss",
                        "type": "SIMPLE",
                        "key": "icmppingloss",
                        "delay": "3m",
                        "history": "90d",
                        "value_type": "FLOAT",
                        "units": "%",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "network"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "a6d87703c75943ac89c2e680235f549b",
                                "expression": "min(/D-Link DGS-3100-24 by SNMP/icmppingloss,5m)>{$ICMP_LOSS_WARN} and min(/D-Link DGS-3100-24 by SNMP/icmppingloss,5m)<100",
                                "name": "Alta perda de pacotes ICMP",
                                "opdata": "Perda: {ITEM.LASTVALUE1}",
                                "priority": "WARNING",
                                "manual_close": "YES",
                                "dependencies": [
                                    {
                                        "name": "Switch sem resposta ICMP",
                                        "expression": "max(/D-Link DGS-3100-24 by SNMP/icmpping,#3)=0"
                                    }
                                ],
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "79ad2c208ebb41249dbfa8e973745857",
                        "name": "ICMP response time",
                        "type": "SIMPLE",
                        "key": "icmppingsec",
                        "delay": "3m",
                        "history": "90d",
                        "value_type": "FLOAT",
                        "units": "s",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "network"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "5de4dd9e0521499d91027cad40bef0f5",
                                "expression": "avg(/D-Link DGS-3100-24 by SNMP/icmppingsec,5m)>{$ICMP_RESPONSE_TIME_WARN}",
                                "name": "Latência ICMP elevada",
                                "opdata": "Latência: {ITEM.LASTVALUE1}",
                                "priority": "WARNING",
                                "manual_close": "YES",
                                "dependencies": [
                                    {
                                        "name": "Alta perda de pacotes ICMP",
                                        "expression": "min(/D-Link DGS-3100-24 by SNMP/icmppingloss,5m)>{$ICMP_LOSS_WARN} and min(/D-Link DGS-3100-24 by SNMP/icmppingloss,5m)<100"
                                    },
                                    {
                                        "name": "Switch sem resposta ICMP",
                                        "expression": "max(/D-Link DGS-3100-24 by SNMP/icmpping,#3)=0"
                                    }
                                ],
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "6e3f10e4ff0d4f1a8f16d41a42e464cd",
                        "name": "Fan1: status operacional",
                        "type": "SNMP_AGENT",
                        "snmp_oid": "get[1.3.6.1.2.1.47.1.1.1.1.16.67109249]",
                        "key": "sensor.fan.status[entPhysicalOperStatus.fan1]",
                        "delay": "3m",
                        "history": "90d",
                        "trends": "0",
                        "description": "MIB: ENTITY-MIB — entPhysicalOperStatus (index 67109249 = Fan1)\nConfirmado via snmpwalk: retornou 2 (FAILED) — corresponde ao LED vermelho.\n\nValores possíveis:\n1 = ok\n2 = failed  ← ESTADO ATUAL\n3 = warning\n4 = nonoperational\n5 = unknown",
                        "valuemap": {
                            "name": "ENTITY-MIB::entPhysicalOperStatus"
                        },
                        "tags": [
                            {
                                "tag": "component",
                                "value": "fan"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "0eaae59ac4874a69b76c09017b2aa7f8",
                                "expression": "last(/D-Link DGS-3100-24 by SNMP/sensor.fan.status[entPhysicalOperStatus.fan1])<>1",
                                "name": "Fan1: falha ou estado anormal detectado",
                                "opdata": "Estado atual: {ITEM.LASTVALUE1}",
                                "priority": "AVERAGE",
                                "description": "O ventilador reportou status diferente de \"ok\" (1).\nEstado 2=failed corresponde ao LED vermelho \"Fan Err\" no painel frontal.\n\nVerifique fisicamente o equipamento — o ventilador pode precisar de substituição.",
                                "manual_close": "YES",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "24317c0c11224f5ab06a7c675ce3b20c",
                        "name": "PSU: status operacional",
                        "type": "SNMP_AGENT",
                        "snmp_oid": "get[1.3.6.1.2.1.47.1.1.1.1.16.67109185]",
                        "key": "sensor.psu.status[entPhysicalOperStatus.psu1]",
                        "delay": "3m",
                        "history": "90d",
                        "trends": "0",
                        "description": "MIB: ENTITY-MIB — entPhysicalOperStatus (index 67109185 = Main PowerSupply)\nConfirmado via snmpwalk: retornou 1 (ok)",
                        "valuemap": {
                            "name": "ENTITY-MIB::entPhysicalOperStatus"
                        },
                        "tags": [
                            {
                                "tag": "component",
                                "value": "power"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "b266868c78374ab3a6255ee202fb91e9",
                                "expression": "last(/D-Link DGS-3100-24 by SNMP/sensor.psu.status[entPhysicalOperStatus.psu1])<>1",
                                "name": "PSU: falha ou estado anormal detectado",
                                "opdata": "Estado atual: {ITEM.LASTVALUE1}",
                                "priority": "HIGH",
                                "description": "A fonte de alimentação principal reportou status diferente de ok. Verifique o equipamento.",
                                "manual_close": "YES",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    }
                                ]
                            }
                        ]
                    },
