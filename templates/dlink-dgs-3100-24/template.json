                "discovery_rules": [
                    {
                        "uuid": "b3b3f730f79d48bf971822fb0994c6bb",
                        "name": "Descoberta de interfaces físicas",
                        "type": "SNMP_AGENT",
                        "snmp_oid": "discovery[{#IFNAME},1.3.6.1.2.1.31.1.1.1.1,{#IFADMINSTATUS},1.3.6.1.2.1.2.2.1.7,{#IFOPERSTATUS},1.3.6.1.2.1.2.2.1.8]",
                        "key": "net.if.discovery",
                        "delay": "1h",
                        "filter": {
                            "evaltype": "AND",
                            "conditions": [
                                {
                                    "macro": "{#IFADMINSTATUS}",
                                    "value": "{$NET.IF.IFADMINSTATUS.NOT_MATCHES}",
                                    "operator": "NOT_MATCHES_REGEX"
                                },
                                {
                                    "macro": "{#IFNAME}",
                                    "value": "^1:([1-9]|1[0-9]|2[0-4])$"
                                },
                                {
                                    "macro": "{#IFOPERSTATUS}",
                                    "value": "{$NET.IF.IFOPERSTATUS.NOT_MATCHES}",
                                    "operator": "NOT_MATCHES_REGEX"
                                }
                            ]
                        },
                        "item_prototypes": [
                            {
                                "uuid": "d957cc9b982a4bc0a628407f515f0d81",
                                "name": "Interface {#IFNAME}: status administrativo",
                                "type": "SNMP_AGENT",
                                "snmp_oid": "1.3.6.1.2.1.2.2.1.7.{#SNMPINDEX}",
                                "key": "net.if.adminstatus[{#SNMPINDEX}]",
                                "delay": "3m",
                                "history": "90d",
                                "tags": [
                                    {
                                        "tag": "component",
                                        "value": "network"
                                    },
                                    {
                                        "tag": "interface",
                                        "value": "{#IFNAME}"
                                    }
                                ]
                            },
                            {
                                "uuid": "96dba2a1f2d04d92a780b3b68abc84ce",
                                "name": "Interface {#IFNAME}: erros RX",
                                "type": "SNMP_AGENT",
                                "snmp_oid": "1.3.6.1.2.1.2.2.1.14.{#SNMPINDEX}",
                                "key": "net.if.in.errors[{#SNMPINDEX}]",
                                "delay": "3m",
                                "history": "90d",
                                "preprocessing": [
                                    {
                                        "type": "CHANGE_PER_SECOND"
                                    }
                                ],
                                "tags": [
                                    {
                                        "tag": "component",
                                        "value": "network"
                                    },
                                    {
                                        "tag": "interface",
                                        "value": "{#IFNAME}"
                                    }
                                ]
                            },
                            {
                                "uuid": "a79a91ae422d4cebba534442e931c9cf",
                                "name": "Interface {#IFNAME}: tráfego RX",
                                "type": "SNMP_AGENT",
                                "snmp_oid": "1.3.6.1.2.1.31.1.1.1.6.{#SNMPINDEX}",
                                "key": "net.if.in[{#SNMPINDEX}]",
