                                ]
                            },
                            {
                                "uuid": "cfc96e48364b4d4d85f02254d6c8eab3",
                                "expression": "avg(/Sophos Firewall by SNMP/sfos.memory.util,5m)>{$SOPHOS.MEM.UTIL.HIGH}",
