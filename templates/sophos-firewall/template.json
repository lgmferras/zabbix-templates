                    {
                        "uuid": "c0323429406947c995dce1a1d81323ae",
                        "name": "Sophos: Utilização de CPU",
                        "type": "SNMP_AGENT",
                        "snmp_oid": "get[1.3.6.1.4.1.21067.2.1.2.2.1.0]",
                        "key": "sfos.cpu.util",
                        "delay": "3m",
                        "history": "30d",
                        "value_type": "FLOAT",
                        "units": "%",
                        "description": "Uso atual da CPU (sfosCurrentCPUUsage). Valor em %.",
                        "preprocessing": [
                            {
                                "type": "DISCARD_UNCHANGED_HEARTBEAT",
                                "parameters": [
                                    "5m"
                                ]
                            }
                        ],
                        "tags": [
                            {
                                "tag": "component",
                                "value": "cpu"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "07b7a04ed3ab4564afc693a0218c53c4",
                                "expression": "avg(/Sophos Firewall by SNMP/sfos.cpu.util,5m)>{$SOPHOS.CPU.UTIL.WARN}",
                                "name": "Sophos: CPU alta (> {$SOPHOS.CPU.UTIL.WARN}%)",
                                "event_name": "Sophos: CPU {ITEM.LASTVALUE1}% (limite {$SOPHOS.CPU.UTIL.WARN}%)",
                                "opdata": "Atual: {ITEM.LASTVALUE1}%",
                                "priority": "WARNING",
                                "description": "Uso médio de CPU acima de {$SOPHOS.CPU.UTIL.WARN}% nos últimos 5 minutos.",
                                "manual_close": "YES",
                                "dependencies": [
                                    {
                                        "name": "Sophos: CPU crítica (> {$SOPHOS.CPU.UTIL.HIGH}%)",
                                        "expression": "avg(/Sophos Firewall by SNMP/sfos.cpu.util,5m)>{$SOPHOS.CPU.UTIL.HIGH}"
                                    }
                                ],
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "performance"
                                    }
                                ]
                            },
                            {
                                "uuid": "411c46e29ee34e0e9c3de4bf84b91f2b",
                                "expression": "avg(/Sophos Firewall by SNMP/sfos.cpu.util,5m)>{$SOPHOS.CPU.UTIL.HIGH}",
                                "name": "Sophos: CPU crítica (> {$SOPHOS.CPU.UTIL.HIGH}%)",
                                "event_name": "Sophos: CPU {ITEM.LASTVALUE1}% (limite {$SOPHOS.CPU.UTIL.HIGH}%)",
                                "opdata": "Atual: {ITEM.LASTVALUE1}%",
                                "priority": "HIGH",
                                "description": "Uso médio de CPU acima de {$SOPHOS.CPU.UTIL.HIGH}% nos últimos 5 minutos.",
                                "manual_close": "YES",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "performance"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "612242fdcd29400e8daf76480826178b",
