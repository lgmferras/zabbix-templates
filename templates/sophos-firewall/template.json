        "templates": [
            {
                "uuid": "d6ae6cce2ded4cae9c0cbc04a5cef3e4",
                "template": "Sophos Firewall by SNMP",
                "name": "Sophos Firewall by SNMP",
                "description": "Monitora Sophos XG/SFOS via SNMP v2c usando a MIB XG-FIREWALL-MIB (enterprise 21067).\n\nMétricas: CPU, memória, disco, usuários ativos, status dos gateways WAN (failover),\nthroughput das interfaces WAN1, WAN2 e LAN.\n\nTrigger de failover: detecta quando o gateway de backup (WAN2) se torna ativo,\nindicando que o link primário falhou e o Sophos realizou a troca de rota.\n\nPré-requisito: SNMP v2c habilitado no Sophos (Administration > SNMP).\nAplique ao host 'SITE - FIREWALL' com interface SNMP apontando para o IP da WAN1.",
                "groups": [
                    {
                        "name": "Templates/Network devices"
                    }
                ],
                "items": [
                    {
                        "uuid": "d2229ff3364c46f3ac3a9366f6b9c4e6",
                        "name": "Sophos: {$SOPHOS.IF.LAN.NAME} — bits recebidos",
                        "type": "SNMP_AGENT",
                        "snmp_oid": "get[1.3.6.1.2.1.2.2.1.10.{$SOPHOS.IF.LAN.INDEX}]",
                        "key": "net.if.in[{$SOPHOS.IF.LAN.NAME},bits]",
                        "delay": "3m",
                        "history": "30d",
                        "units": "bps",
                        "description": "Taxa de bits recebidos na interface LAN (ifInOctets × 8).",
                        "preprocessing": [
                            {
                                "type": "CHANGE_PER_SECOND"
                            },
                            {
                                "type": "MULTIPLIER",
                                "parameters": [
                                    "8"
                                ]
                            }
                        ],
                        "tags": [
                            {
                                "tag": "component",
                                "value": "network"
                            }
                        ]
                    },
                    {
