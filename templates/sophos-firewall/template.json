                                "name": "Sophos: Disco alto (> {$SOPHOS.DISK.UTIL.WARN}%)",
                                "event_name": "Sophos: Disco {ITEM.LASTVALUE1}% (limite {$SOPHOS.DISK.UTIL.WARN}%)",
                                "opdata": "Atual: {ITEM.LASTVALUE1}%",
                                "priority": "WARNING",
                                "description": "Uso de disco acima de {$SOPHOS.DISK.UTIL.WARN}%.",
                                "manual_close": "YES",
                                "dependencies": [
                                    {
                                        "name": "Sophos: Disco crítico (> {$SOPHOS.DISK.UTIL.HIGH}%)",
                                        "expression": "last(/Sophos Firewall by SNMP/sfos.disk.util)>{$SOPHOS.DISK.UTIL.HIGH}"
                                    }
                                ],
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "capacity"
                                    }
                                ]
                            },
                            {
                                "uuid": "a2b9012a64994bb39a8e206e36976b7b",
                                "expression": "last(/Sophos Firewall by SNMP/sfos.disk.util)>{$SOPHOS.DISK.UTIL.HIGH}",
                                "name": "Sophos: Disco crítico (> {$SOPHOS.DISK.UTIL.HIGH}%)",
                                "event_name": "Sophos: Disco {ITEM.LASTVALUE1}% (limite {$SOPHOS.DISK.UTIL.HIGH}%)",
                                "opdata": "Atual: {ITEM.LASTVALUE1}%",
                                "priority": "HIGH",
                                "description": "Uso de disco acima de {$SOPHOS.DISK.UTIL.HIGH}%. Logs e relatórios podem ser descartados.",
                                "manual_close": "YES",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "capacity"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "43d7a100ee0a494cbd4f70743c39ebff",
                        "name": "Sophos: Versão do firmware",
                        "type": "SNMP_AGENT",
                        "snmp_oid": "get[1.3.6.1.4.1.21067.2.1.1.3.0]",
                        "key": "sfos.firmware.version",
                        "delay": "1h",
                        "history": "7d",
                        "value_type": "CHAR",
                        "description": "Versão do SFOS (sfosDevFWVersion). Ex: SFOS 17.5.17 MR-17-Build837.",
                        "preprocessing": [
                            {
                                "type": "DISCARD_UNCHANGED_HEARTBEAT",
                                "parameters": [
                                    "1d"
                                ]
                            }
                        ],
                        "tags": [
                            {
                                "tag": "component",
                                "value": "system"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "8531d24011be493bbeb04cf3564b8457",
                                "expression": "change(/Sophos Firewall by SNMP/sfos.firmware.version)=1",
                                "name": "Sophos: Versão do firmware alterada",
                                "opdata": "Versão atual: {ITEM.LASTVALUE1}",
                                "priority": "INFO",
                                "description": "O firmware do Sophos foi atualizado ou modificado.",
                                "manual_close": "YES",
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "notice"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "4b720ee74f4944b4a61eae71066d6491",
                        "name": "Sophos: Status do gateway WAN1",
                        "type": "SNMP_AGENT",
                        "snmp_oid": "get[1.3.6.1.4.1.21067.2.1.3.1.1.0]",
                        "key": "sfos.gateway.status[1]",
                        "delay": "3m",
                        "history": "30d",
                        "description": "Status do gateway 1 (WAN1) conforme MIB Sophos XG.\n1=Ativo, 2=Inativo.",
                        "valuemap": {
                            "name": "Sophos gateway status"
                        },
                        "preprocessing": [
                            {
                                "type": "DISCARD_UNCHANGED_HEARTBEAT",
                                "parameters": [
                                    "2m"
                                ]
                            }
                        ],
                        "tags": [
                            {
                                "tag": "component",
                                "value": "network"
                            },
                            {
                                "tag": "no_metrics",
                                "value": "true"
                            }
                        ]
                    },
                    {
                        "uuid": "792a9c9dee79409681a6165062e04e4e",
                        "name": "Sophos: Status do gateway WAN2 (backup)",
                        "type": "SNMP_AGENT",
                        "snmp_oid": "get[1.3.6.1.4.1.21067.2.1.3.2.1.0]",
                        "key": "sfos.gateway.status[2]",
                        "delay": "3m",
                        "history": "30d",
                        "description": "Status do gateway 2 (WAN2/backup) conforme MIB Sophos XG.\n1=Ativo (failover em curso), 2=Inativo (operação normal).",
                        "valuemap": {
                            "name": "Sophos gateway status"
                        },
                        "preprocessing": [
                            {
                                "type": "DISCARD_UNCHANGED_HEARTBEAT",
                                "parameters": [
                                    "2m"
                                ]
                            }
                        ],
                        "tags": [
                            {
                                "tag": "component",
                                "value": "network"
                            },
                            {
                                "tag": "no_metrics",
                                "value": "true"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "6c85dbcbcbc24325b61210a86853c5f4",
                                "expression": "last(/Sophos Firewall by SNMP/sfos.gateway.status[2])=1",
                                "name": "Sophos: Link de backup WAN2 ativo — verificar WAN1",
                                "event_name": "Sophos: Failover ativo — tráfego roteando via WAN2 ({$SOPHOS.IF.WAN2.NAME})",
                                "opdata": "Gateway WAN2: {ITEM.LASTVALUE1}",
                                "priority": "WARNING",
                                "description": "O Sophos ativou o gateway de backup (WAN2). Isso indica que o link primário (WAN1) foi detectado como inativo pelo próprio firewall e o tráfego está sendo roteado pelo link de contingência.\n\nVerificar: host '{$HOST.WAN1.NAME}' no Zabbix para confirmar falha do link primário.",
                                "manual_close": "YES",
                                "tags": [
                                    {
                                        "tag": "component",
                                        "value": "failover"
                                    },
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    }
                                ]
                            }
                        ]
                    },
                    {
