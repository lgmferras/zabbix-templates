                ],
                "macros": [
                    {
                        "macro": "{$HOST.WAN1.NAME}",
                        "description": "Nome do host WAN1 no Zabbix — referenciado na descrição do trigger de failover"
                    },
                    {
                        "macro": "{$SOPHOS.CPU.UTIL.HIGH}",
