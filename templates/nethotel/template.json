                                "uuid": "8bb2390ccec74b07946cf303f3e1db31",
                                "expression": "min(/NETHOTEL by Zabbix agent active/nethotel.backup.running,{$NETHOTEL.BACKUP.MAX_RUNTIME})=1",
                                "recovery_mode": "RECOVERY_EXPRESSION",
                                "recovery_expression": "min(/NETHOTEL by Zabbix agent active/nethotel.backup.running,{$NETHOTEL.BACKUP.MAX_RUNTIME})=0",
                                "name": "NETHOTEL - Backup pode estar travado (rodando há mais de {$NETHOTEL.BACKUP.MAX_RUNTIME})",
