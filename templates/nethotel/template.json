                                "value": "backup"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "79cfdb8de2634b79891c7992227c2280",
                                "expression": "last(/NETHOTEL by Zabbix agent active/nethotel.backup.file_count)<{$NETHOTEL.BACKUP.EXPECTED_FILES}",
                                "recovery_mode": "RECOVERY_EXPRESSION",
                                "recovery_expression": "last(/NETHOTEL by Zabbix agent active/nethotel.backup.file_count)={$NETHOTEL.BACKUP.EXPECTED_FILES}",
                                "name": "NETHOTEL - Faltam arquivos de backup (menos de {$NETHOTEL.BACKUP.EXPECTED_FILES} dias)",
                                "opdata": "Arquivos: {ITEM.LASTVALUE1} de {$NETHOTEL.BACKUP.EXPECTED_FILES}",
                                "priority": "INFO",
                                "description": "Existem menos de {$NETHOTEL.BACKUP.EXPECTED_FILES} arquivos de backup. Alguns dias da semana podem estar faltando.",
                                "manual_close": "YES",
                                "dependencies": [
                                    {
                                        "name": "NETHOTEL - Nenhum arquivo de backup encontrado",
                                        "expression": "last(/NETHOTEL by Zabbix agent active/nethotel.backup.age_hours)=-1"
