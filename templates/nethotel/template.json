                "uuid": "a7fead13da804ca9a73bc6c1581f87da",
                "template": "NETHOTEL by Zabbix agent active",
                "name": "NETHOTEL by Zabbix agent active",
                "description": "Template para monitoramento da aplicação NETHOTEL (sistema de gestão hoteleira).\nMonitora serviços críticos (Becape, Diária, NFE, NFCE, NFSE, Reservas, B2B) e backup do banco Firebird (.GBK).\n\nRequisitos:\n- Zabbix Agent 2 (active mode) instalado no servidor NETHOTEL\n- UserParameters configurados para cada item key\n- Diretório de backup: C:\\NETHOTEL\n\nMacros ajustáveis por host para personalizar thresholds.\n\nAutor: Systrix Telecom\nVersão: 2.0",
                "groups": [
                    {
                        "name": "Templates/Applications"
                    }
                ],
                "items": [
                    {
                        "uuid": "6b233e0403b940029442d8e9aa6881ea",
                        "name": "NETHOTEL Backup - Idade do último backup (horas)",
                        "type": "ZABBIX_ACTIVE",
                        "key": "nethotel.backup.age_hours",
                        "delay": "1m;10m/1-7,00:00-06:00",
                        "value_type": "FLOAT",
                        "units": "h",
                        "description": "Número de horas desde o último backup. Valores acima de {$NETHOTEL.BACKUP.AGE.WARN}h indicam problema.",
                        "timeout": "30s",
                        "tags": [
                            {
                                "tag": "application",
                                "value": "nethotel"
                            },
                            {
                                "tag": "component",
                                "value": "backup"
                            }
                        ],
                        "triggers": [
                            {
                                "uuid": "2a3426c61ea242e7bd84af7f929c63b1",
                                "expression": "last(/NETHOTEL by Zabbix agent active/nethotel.backup.age_hours)>{$NETHOTEL.BACKUP.AGE.DISASTER}",
                                "recovery_mode": "RECOVERY_EXPRESSION",
                                "recovery_expression": "last(/NETHOTEL by Zabbix agent active/nethotel.backup.age_hours)<={$NETHOTEL.BACKUP.AGE.DISASTER}",
                                "name": "NETHOTEL - Backup CRÍTICO (mais de {$NETHOTEL.BACKUP.AGE.DISASTER} horas sem backup)",
                                "opdata": "Idade: {ITEM.LASTVALUE1}",
                                "priority": "DISASTER",
                                "description": "ATENÇÃO: O último backup tem mais de {$NETHOTEL.BACKUP.AGE.DISASTER} horas! Risco de perda de dados.",
                                "manual_close": "YES",
                                "tags": [
                                    {
                                        "tag": "application",
                                        "value": "nethotel"
                                    },
                                    {
                                        "tag": "component",
                                        "value": "backup"
                                    },
                                    {
                                        "tag": "scope",
                                        "value": "data"
                                    }
                                ]
                            },
                            {
                                "uuid": "de107eae4c5c454e8ba27dd59886ce7d",
                                "expression": "last(/NETHOTEL by Zabbix agent active/nethotel.backup.age_hours)>{$NETHOTEL.BACKUP.AGE.WARN}",
                                "recovery_mode": "RECOVERY_EXPRESSION",
                                "recovery_expression": "last(/NETHOTEL by Zabbix agent active/nethotel.backup.age_hours)<={$NETHOTEL.BACKUP.AGE.WARN}",
                                "name": "NETHOTEL - Backup desatualizado (mais de {$NETHOTEL.BACKUP.AGE.WARN} horas)",
                                "opdata": "Idade: {ITEM.LASTVALUE1}",
                                "priority": "WARNING",
                                "description": "O último backup tem mais de {$NETHOTEL.BACKUP.AGE.WARN} horas. Verifique se o processo de backup está funcionando corretamente.",
                                "manual_close": "YES",
                                "dependencies": [
                                    {
                                        "name": "NETHOTEL - Backup CRÍTICO (mais de {$NETHOTEL.BACKUP.AGE.DISASTER} horas sem backup)",
                                        "expression": "last(/NETHOTEL by Zabbix agent active/nethotel.backup.age_hours)>{$NETHOTEL.BACKUP.AGE.DISASTER}",
                                        "recovery_expression": "last(/NETHOTEL by Zabbix agent active/nethotel.backup.age_hours)<={$NETHOTEL.BACKUP.AGE.DISASTER}"
                                    }
                                ],
                                "tags": [
                                    {
                                        "tag": "application",
                                        "value": "nethotel"
                                    },
                                    {
                                        "tag": "component",
                                        "value": "backup"
                                    },
                                    {
                                        "tag": "scope",
                                        "value": "data"
                                    }
                                ]
                            },
                            {
                                "uuid": "e2ec3d784b614234a3c09fbeb537ad59",
                                "expression": "last(/NETHOTEL by Zabbix agent active/nethotel.backup.age_hours)=-1",
                                "name": "NETHOTEL - Nenhum arquivo de backup encontrado",
                                "opdata": "Nenhum .GBK em C:\\NETHOTEL",
                                "priority": "DISASTER",
                                "description": "Não foram encontrados arquivos de backup .GBK no diretório C:\\NETHOTEL",
                                "manual_close": "YES",
                                "tags": [
                                    {
                                        "tag": "application",
                                        "value": "nethotel"
                                    },
                                    {
                                        "tag": "component",
                                        "value": "backup"
                                    },
